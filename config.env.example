# Non-secret settings. Copy to config.env; secrets go in .env (see
# .env.example), which wins when both set a key. Every setting and its default
# is in app/config.py; these are the ones operators usually change.

# Server (read by start.sh)
HOST=0.0.0.0
PORT=8088
#FORWARDED_ALLOW_IPS=127.0.0.1
#LIMIT_CONCURRENCY=256

# Public HTTPS URL of this box: invite links and connector install lines.
# Needs a trusted certificate.
#PUBLIC_BASE_URL=https://fuse.example.com
#TRUSTED_HOSTS=fuse.example.com

# Database pool size (shared with every other app on the MariaDB server).
#DATABASE_POOL_SIZE=48

# Open registration (default: invite-only after the first user).
#ALLOW_REGISTER=false
# Days an admin invite link stays valid.
#INVITE_TTL_DAYS=14
# Days a sign-in lasts, however actively it is used.
#SESSION_MAX_AGE_DAYS=30
# Let users add SSH hosts on private (RFC1918) addresses.
#ALLOW_PRIVATE_HOSTS=false

# Dictation in chat. Needs an OpenAI-compatible speech-to-text server (e.g.
# Speaches); set it up on /admin/sources#speech once this is on.
#SPEECH_ENABLED=false

# run_code: coding agents run JavaScript that calls their tools in a V8 REPL
# kept per chat (needs the mini-racer package from requirements.txt).
#CODE_MODE=true

# Optional site-wide llama.cpp backend (its key is LLAMA_API_KEY in .env).
#LLAMA_BASE_URL=

# Static assets: cache /static?v= URLs for a year (set false on a dev box).
#STATIC_IMMUTABLE=true
# Refresh pooled OAuth tokens. Only the instance that owns them may (false on dev).
#OAUTH_REFRESH_ENABLED=true

# Instance-wide cleanup ceilings in days (0 = off).
#RETENTION_FORCE_ARCHIVE_DAYS=0
#RETENTION_FORCE_DELETE_DAYS=0
# Mandatory for every user (0 = off): delete chats idle this many days, and
# artifacts nobody opened or changed this many days.
#CHAT_MAX_IDLE_DAYS=30
#ARTIFACT_MAX_IDLE_DAYS=7
# Mandatory for every user (0 = off): delete images and attached files from
# chats idle this many days (archived chats lose them either way); drop the
# stored transcript of a finished subagent,
# and of a turn a newer one replaced, this many days after it ended.
#CHAT_MEDIA_IDLE_DAYS=3
#CHAT_AGENT_TRANSCRIPT_DAYS=1
#CHAT_RUN_TRANSCRIPT_DAYS=1

# Context meter and compaction.
#CONTEXT_AUTO_COMPACT=true
#CONTEXT_SUMMARIZER_MODEL=
